{"nodes": [{"id": "agents_anime_look_director_project_instructions", "label": "AGENTS.md Project Instructions", "file_type": "document", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_verification_gate", "label": "Headless Verification Gate (preset_dev/verify.py)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must print ALD GATE: PASS after every change; structural checks alone missed a light-wrap bug, so the gate also does render-level pixel checks."}, {"id": "agents_compositor_stack", "label": "ALD | Compositor Stack", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One node group per scene (Render Layers -> Glare -> Sun Beams -> Kuwahara -> Light Wrap -> Ink -> Lensdist -> Group Output); a full rebuild costs ~5-8 ms so slider updates can be synchronous, and update_params (0.34 ms) rewrites sockets instead of rebuilding."}, {"id": "agents_kuwahara_painterly", "label": "Kuwahara Painterly Filter (geometry-masked)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ALD | Kuwahara Geometry multiplies the depth factor so the sky and stars are never smeared by the painterly filter."}, {"id": "agents_light_wrap", "label": "Light Wrap", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mask = outer silhouette band + depth-discontinuity band; the depth threshold is baked from the camera clip end at build time."}, {"id": "agents_anime_ink_lines", "label": "Anime Ink Lines (depth + Normal)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_aerial_haze", "label": "Aerial Haze", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_god_rays", "label": "God Rays (Glare Sun Beams)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Sun Beams node is always created when god_rays is on; with the sun behind the camera it starts at (0.5,0.5) with strength 0 so the frame handler can find it later."}, {"id": "agents_rim_light", "label": "Rim Light (Fresnel band)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw Layer Weight Facing covered 68% of the gate frame; the MapRange (1 - Rim Width .. 1) threshold curve keeps it edge-local at ~6.5%."}, {"id": "agents_cel_terminator", "label": "Cel Terminator (N.L + AO)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_rim_emission", "label": "Rim Emission wiring", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Emission bypasses diffuse attenuation so the rim reads in backlight; the wiring skips materials that already have emission and restores the originals on clear."}, {"id": "agents_shadow_tint_group", "label": "ALD | Shadow Tint group (v2)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opt-in and reversible: MULTIPLY mix preserves texture detail, palette shadow colors are normalized multipliers, and clearing restores the original Base Color link or value. Toggle off zeroes AO while Cel/Rim stay on."}, {"id": "agents_world_gradient_group", "label": "ALD | World Gradient group", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hosts the sky gradient, sun disk, stars, clouds and the legacy sky FX; palette colors are wired through group sockets (never baked into ColorRamp stops) and the ald_build marker forces older graphs to rebuild."}, {"id": "agents_fx_particles", "label": "FX 3D Particle Systems (fx.py / ALD | FX)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Physical 3D fireworks and meteors with real depth, gravity and overlap, separate from the world shader's sky, clouds, stars and Milky Way."}, {"id": "agents_geometry_nodes_backend", "label": "Geometry Nodes FX Backend (ALD | FX Burst GN / Trail GN)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The frame handler writes no geometry in this path: 2.5 ms/frame against 121.7 ms for the Python writer."}, {"id": "agents_fx_particle_solver", "label": "Analytic FX Particle Solver", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Particles are evaluated analytically from hashed per-particle data, so results are independent of frame history and frame rate; the stable form avoids cancellation for small drag."}, {"id": "agents_fx_persistent_schema", "label": "Persistent FX Schema (ALD_FX_System / ALD_FX_Event)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The saved file is the source of truth; the runtime registry is only a cache, and objects are found by (event UID, role) so user renames never break the registry."}, {"id": "agents_fx_material_contract", "label": "FX Particle Material Contract", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "role/age_norm/energy/trail_u/stable_noise/event_color drive the shader; missing attributes keep neutral values so older files never go black."}, {"id": "agents_fx_clock", "label": "Per-System FX Clock (Timeline / Preview / Burst Age)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "fx.set_age writes the Age Offset of the modifiers instead of rebuilding: the slider never recreates objects or rewrites the deterministic data."}, {"id": "agents_fx_compositing_contract", "label": "FX Recomposition Contract C = (1-A)*Painted_B + F + Glare(F)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EEVEE writes Alpha=1 even with a transparent world override, so coverage A must be max(R,G,B) of the FX-only render, not alpha; the painterly filters run on a base without FX and F is added premultiplied with Factor 1."}, {"id": "agents_snapshot_lifecycle", "label": "Snapshot / Restore Lifecycle (ald_snapshot, REMOVED state)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "snapshot.ensure runs before every mutation path so a user without a palette apply can still get their world, sun, materials and compositor back; ald_maintenance suspends handlers during the restore."}, {"id": "agents_ald_sky_fx_anchor", "label": "ALD Sky/FX Anchor", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A persistent Empty holding vertical axis, ground elevation and units scale; identified by UID so it survives rebuilds, and it feeds gravity and launch points to every solver."}, {"id": "agents_ui_surface_parity", "label": "Scene Properties / View3D Sidebar Parity", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Panels never draw state themselves: shared draw_* functions mean the two surfaces cannot diverge, and the gate fails when they do."}, {"id": "agents_scene_actions", "label": "Bypass / Remove ALD / Detach and Keep Result", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three distinct intents: stop touching the scene, remove completely (restore snapshot), or keep the look while dropping management."}, {"id": "agents_atmospheric_smoke", "label": "Atmospheric Smoke (ALD | Smoke volume)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A real volumetric object rendered by the environment (B layer), so it is not subject to the additive FX coverage."}, {"id": "agents_palette_precedence", "label": "Effective Palette Precedence (camera > marker > base)", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Markers must never write Scene.ald.palette: look.apply stores ald_effective_palette/source so the base palette survives for shots without an override."}], "edges": [{"source": "agents_world_gradient_group", "target": "readme_four_zone_sky", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_world_gradient_group", "target": "readme_perspective_planar_anime_clouds", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_world_gradient_group", "target": "readme_three_tier_starfield", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_world_gradient_group", "target": "readme_visible_sky_ambient_split", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_compositor_stack", "target": "agents_kuwahara_painterly", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_compositor_stack", "target": "agents_light_wrap", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_compositor_stack", "target": "agents_anime_ink_lines", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_compositor_stack", "target": "agents_aerial_haze", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_compositor_stack", "target": "agents_god_rays", "relation": "re